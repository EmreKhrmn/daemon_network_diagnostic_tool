{
    "explorerSort.rules": [
        {
            "name": "Auto-generated for **",
            "pathPattern": "**",
            "priorities": [
                {
                    "condition": "name === '1-machine_info.py'",
                    "priority": -100
                },
                {
                    "condition": "name === 'machine_info.py'",
                    "priority": -100
                },
                {
                    "condition": "name === 'README.md'",
                    "priority": 100
                },
                {
                    "condition": "name === '.vscode'",
                    "priority": 100
                },
                {
                    "condition": "name === '__pycache__'",
                    "priority": 100
                },
                {
                    "condition": "name === 'test.py'",
                    "priority": 100
                },
                {
                    "condition": "name === '.venv'",
                    "priority": 100
                },
                {
                    "condition": "name === 'todo.txt'",
                    "priority": 200
                }
            ]
        }
    ]
}