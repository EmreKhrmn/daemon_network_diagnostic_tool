{
    "explorerSort.rules": [
        {
            "name": "Auto-generated for **",
            "pathPattern": "**",
            "priorities": [
                {
                    "condition": "name === '1-machine_info.py'",
                    "priority": -100
                },
                {
                    "condition": "name === 'machine_info.py'",
                    "priority": -100
                },
                {
                    "condition": "name === 'README.md'",
                    "priority": 100
                },
                {
                    "condition": "name === '.vscode'",
                    "priority": 100
                },
                {
                    "condition": "name === '__pycache__'",
                    "priority": 100
                },
                {
                    "condition": "name === 'test.py'",
                    "priority": 200
                },
                {
                    "condition": "name === '.venv'",
                    "priority": 100
                },
                {
                    "condition": "name === 'todo.txt'",
                    "priority": 300
                },
                {
                    "condition": "name === 'echo_test.py'",
                    "priority": -200
                },
                {
                    "condition": "name === 'simple_chat.py'",
                    "priority": -300
                },
                {
                    "condition": "name === 'sntp_time.py'",
                    "priority": -200
                },
                {
                    "condition": "name === 'settings_errors.py'",
                    "priority": -400
                }
            ]
        },
        {
            "name": "Auto-generated for **/*",
            "pathPattern": "**/*",
            "priorities": [
                {
                    "condition": "name === 'echo_test.py'",
                    "priority": -100,
                    "referenceFile": "machine_info.py",
                    "offset": -1
                }
            ]
        },
        {
            "name": "Auto-generated for **/.vscode/**",
            "pathPattern": "**/.vscode/**",
            "priorities": [
                {
                    "condition": "name === 'A'",
                    "priority": -100
                }
            ]
        }
    ]
}